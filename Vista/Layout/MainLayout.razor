@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage
@inject AuthenticationStateProvider AuthStateProvider

<div class="page">
    @if (!EsPaginaLogin)
    {
        <div class="sidebar">
            <NavMenu />
        </div>
    }

    <main>
        <div class="top-row px-4 d-flex justify-content-between align-items-center bg-white shadow-sm">
            @if (!EsPaginaLogin)
            {
                <!-- Aquí puedes cambiar "📚 Biblioteca Digital" por el nombre que quieras darle a tu app -->
                <span class="fw-bold text-dark fs-5">📚 Biblioteca Digital</span>

                <button class="btn btn-outline-danger btn-sm fw-bold px-3 rounded-pill" @onclick="CerrarSesion">
                    <i class="bi bi-box-arrow-right me-1"></i> Cerrar Sesión
                </button>
            }
            else
            {
                <span></span>
            }
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

@code {
    private bool EsPaginaLogin => Navigation.Uri.Contains("/login") || Navigation.Uri.Contains("/registro");

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += (s, e) => StateHasChanged();
    }

    private async Task CerrarSesion()
    {
        await LocalStorage.RemoveItemAsync("authToken");
        
        // Forzamos la recarga de la página apuntando al login
        Navigation.NavigateTo("/login", forceLoad: true);
    }
}
