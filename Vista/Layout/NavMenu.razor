<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Biblioteca</a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
    <nav class="nav flex-column">

        <!-- TODO EL MENÚ SE OCULTA SI NO HAY SESIÓN INICIADA -->
        <AuthorizeView>
            <Authorized>

                <!-- 1. LECTORES (Roles 3 y 4) -->
                <AuthorizeView Roles="3, 4" Context="lectorContext">
                    <Authorized>
                        <div class="nav-item px-3">
                            <NavLink class="nav-link d-flex align-items-center" href="catalogo-libros">
                                <i class="bi bi-journal-album fs-5 me-2 mb-1" aria-hidden="true"></i> <span>Catálogo de Libros</span>
                            </NavLink>
                        </div>
                        <div class="nav-item px-3">
                            <NavLink class="nav-link d-flex align-items-center" href="mis-prestamos">
                                <i class="bi bi-bookmark-check-fill fs-5 me-2 mb-1" aria-hidden="true"></i> <span>Mis Préstamos</span>
                            </NavLink>
                        </div>
                    </Authorized>
                </AuthorizeView>

                <!-- 2. ADMIN Y BIBLIOTECARIO (Roles 1 y 2) -->
                <AuthorizeView Roles="1, 2" Context="adminContext">
                    <Authorized>
                        <div class="nav-item px-3">
                            <NavLink class="nav-link d-flex align-items-center" href="libros">
                                <i class="bi bi-journal-text fs-5 me-2 mb-1" aria-hidden="true"></i> <span>Gestión de Libros</span>
                            </NavLink>
                        </div>
                        <div class="nav-item px-3">
                            <NavLink class="nav-link d-flex align-items-center" href="prestamos">
                                <i class="bi bi-journal-check fs-5 me-2 mb-1" aria-hidden="true"></i> <span>Gestión de Préstamos</span>
                            </NavLink>
                        </div>
                        <div class="nav-item px-3">
                            <NavLink class="nav-link d-flex align-items-center" href="autores">
                                <i class="bi bi-person-badge-fill fs-5 me-2 mb-1" aria-hidden="true"></i> <span>Autores</span>
                            </NavLink>
                        </div>
                        <div class="nav-item px-3">
                            <NavLink class="nav-link d-flex align-items-center" href="lectores">
                                <i class="bi bi-people-fill fs-5 me-2 mb-1" aria-hidden="true"></i> <span>Lectores</span>
                            </NavLink>
                        </div>
                        <div class="nav-item px-3">
                            <NavLink class="nav-link d-flex align-items-center" href="maestro-detalle-lectores">
                                <i class="bi bi-clock-history fs-5 me-2 mb-1" aria-hidden="true"></i> <span>Historial Lectores</span>
                            </NavLink>
                        </div>
                        <div class="nav-item px-3">
                            <NavLink class="nav-link d-flex align-items-center" href="reporte-prestamos">
                                <i class="bi bi-table fs-5 me-2 mb-1" aria-hidden="true"></i> <span>Reporte Vista SQL</span>
                            </NavLink>
                        </div>
                    </Authorized>
                </AuthorizeView>

                <!-- 3. SOLO ADMIN (Rol 1) -->
                <AuthorizeView Roles="1" Context="soloAdminContext">
                    <Authorized>
                        <div class="nav-item px-3">
                            <NavLink class="nav-link d-flex align-items-center" href="empleados">
                                <i class="bi bi-person-workspace fs-5 me-2 mb-1" aria-hidden="true"></i> <span>Empleados</span>
                            </NavLink>
                        </div>
                    </Authorized>
                </AuthorizeView>

            </Authorized>
        </AuthorizeView>

    </nav>
</div>

@code {
    private bool collapseNavMenu = true;
    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;
    private void ToggleNavMenu() => collapseNavMenu = !collapseNavMenu;
}