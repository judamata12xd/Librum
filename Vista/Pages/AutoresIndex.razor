@page "/autores"
@inject IRepositorio Repositorio

<h3 class="text-center mt-4">Gestión de Autores</h3>
<div class="d-flex justify-content-end mb-3">
    <button class="btn btn-primary" @onclick="MostrarFormulario">
        Agregar Autor
    </button>
</div>

@if (mostrarAlerta)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @mensajeAlerta
        <button type="button" class="btn-close" @onclick="() => mostrarAlerta = false"></button>
    </div>
}

@if (autores == null)
{
    <div class="text-center">
        <div class="spinner-border text-primary" role="status"></div>
        <p>Cargando autores...</p>
    </div>
}
else if (!autores.Any())
{
    <div class="alert alert-info text-center">No hay autores registrados.</div>
}
else
{
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>ID Autor</th>
                <th>Nombre</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var autor in autores)
            {
                <tr>
                    <td>@autor.Idautor</td>
                    <td>@autor.Nombre</td>
                    <td>
                        <button class="btn btn-warning btn-sm me-2" @onclick="() => EditarAutor(autor)">Editar</button>
                        <button class="btn btn-danger btn-sm" @onclick="() => EliminarAutor(autor.Idautor)">Eliminar</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@if (mostrarFormulario)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(isEditing ? "Editar Autor" : "Agregar Autor")</h5>
                    <button type="button" class="btn-close" @onclick="Cancelar"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="autorActual" OnValidSubmit="GuardarAutor">

                        <div class="mb-3">
                            <label class="form-label">Nombre del Autor:</label>
                            <InputText class="form-control" @bind-Value="autorActual.Nombre" required />
                        </div>

                        <div class="d-flex justify-content-end mt-3">
                            <button type="submit" class="btn btn-success me-2">Guardar</button>
                            <button type="button" class="btn btn-secondary" @onclick="Cancelar">Cancelar</button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<Autore>? autores;
    private Autore autorActual = new();
    private bool mostrarFormulario = false;
    private bool isEditing = false;
    private string? mensajeAlerta;
    private bool mostrarAlerta = false;

    protected override async Task OnInitializedAsync()
    {
        await CargarAutores();
    }

    private async Task CargarAutores()
    {
        var url = "api/autores";
        autores = await Repositorio.GetAsync<List<Autore>>(url);
    }

    private void MostrarFormulario()
    {
        autorActual = new Autore();
        isEditing = false;
        mostrarFormulario = true;
    }

    private void EditarAutor(Autore autor)
    {
        autorActual = new Autore
        {
            Idautor = autor.Idautor,
            Nombre = autor.Nombre
        };
        isEditing = true;
        mostrarFormulario = true;
    }

    private async Task GuardarAutor()
    {
        var url1 = "api/autores";
        var url2 = $"api/autores/{autorActual.Idautor}";

        if (!isEditing)
            await Repositorio.PostAsync(url1, autorActual);
        else
            await Repositorio.PutAsync(url2, autorActual);

        await CargarAutores();
        mostrarFormulario = false;
        mensajeAlerta = "Autor guardado exitosamente.";
        mostrarAlerta = true;
    }

    private async Task EliminarAutor(int id)
    {
        var url2 = $"api/autores/{id}";
        await Repositorio.DeleteAsync(url2);
        await CargarAutores();
        mensajeAlerta = "Autor eliminado exitosamente.";
        mostrarAlerta = true;
    }

    private void Cancelar()
    {
        mostrarFormulario = false;
    }
}