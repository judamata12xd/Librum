@page "/catalogo-libros"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "3, 4")]
@inject IRepositorio Repositorio

<h3 class="text-center mt-4">Catálogo de Libros</h3>

<!-- Barra de Búsqueda -->
<div class="row mb-3 justify-content-center">
    <div class="col-md-6">
        <input type="text" class="form-control" placeholder="Buscar por código o nombre del libro..."
               @bind="textoBusqueda" @bind:event="oninput" />
    </div>
</div>

@if (libros == null)
{
    <div class="text-center">
        <div class="spinner-border text-primary" role="status"></div>
        <p>Cargando catálogo...</p>
    </div>
}
else if (!LibrosFiltrados.Any())
{
    <div class="alert alert-info text-center">No se encontraron libros con ese criterio.</div>
}
else
{
    <table class="table table-striped table-hover mt-3">
        <thead class="table-dark">
            <tr>
                <th>Código</th>
                <th>Nombre del Libro</th>
                <th>Disponibles</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var libro in LibrosFiltrados)
            {
                <tr>
                    <td>@libro.Codlibro</td>
                    <td>@libro.Nombre</td>
                    <td>
                        @if (libro.Disponible > 0)
                        {
                            <span class="badge bg-success">@libro.Disponible unidades</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Agotado</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<Libro>? libros;
    private string textoBusqueda = string.Empty;

    // Propiedad calculada que filtra en tiempo real por Nombre o Código
    private IEnumerable<Libro> LibrosFiltrados =>
        string.IsNullOrWhiteSpace(textoBusqueda)
            ? (libros ?? new List<Libro>())
            : libros!.Where(l => l.Nombre.Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase) ||
                                 l.Codlibro.ToString().Contains(textoBusqueda));

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var url = "api/Libros";
            libros = await Repositorio.GetAsync<List<Libro>>(url);
            if (libros == null) libros = new List<Libro>();
        }
        catch (Exception)
        {
            libros = new List<Libro>();
        }
    }
}