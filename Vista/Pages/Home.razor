@page "/"
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider

@if (cargando)
{
    <div class="text-center mt-5">
        <div class="spinner-border text-primary" role="status"></div>
        <p class="mt-2 text-muted">Verificando sesión...</p>
    </div>
}
else
{
    <!-- Contenedor adaptado que respeta el menú lateral y la barra superior, con fondo degradado -->
    <div class="container-fluid min-vh-100 d-flex align-items-center justify-content-center" style="background: linear-gradient(135deg, #f0f3f8 0%, #d9e2ec 100%); margin: -1.5rem; width: calc(100% + 3rem); height: calc(100vh - 60px);">
        <div class="row justify-content-center w-100">
            <div class="col-md-7 text-center">
                <div class="card shadow-lg border-0 rounded-4 p-5 bg-white">
                    <div class="mb-3">
                        <i class="bi bi-book-half text-primary display-1"></i>
                    </div>
                    <h1 class="fw-bold text-dark mb-3">¡Bienvenido al Sistema de Biblioteca!</h1>
                    <p class="text-muted fs-5 mb-0">
                        Gestiona libros, préstamos, lectores y consultas de manera rápida, segura y organizada.
                    </p>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool cargando = true;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        // Si NO ha iniciado sesión, lo mandamos directo al login automáticamente
        if (user.Identity == null || !user.Identity.IsAuthenticated)
        {
            Navigation.NavigateTo("/login", true);
        }
        else
        {
            // Si SÍ está logueado, se muestra la bienvenida con el fondo nuevo sin tapar el menú
            cargando = false;
        }
    }
}