@page "/libros"
@inject IRepositorio Repositorio

<h3 class="text-center mt-4">Gestión de Libros</h3>

<div class="row mb-3">
    <div class="col-md-8">
        <div class="input-group">
            <span class="input-group-text bg-dark text-white"><i class="bi bi-search"></i> Buscar</span>
    
            <input type="text" class="form-control" placeholder="Escribe el código o nombre del libro..." 
                   @bind="filtroBusqueda" @bind:event="oninput" />
        </div>
    </div>
    <div class="col-md-4 text-end">
        <button class="btn btn-primary" @onclick="MostrarFormulario">
            Agregar Libro
        </button>
    </div>
</div>

@if (mostrarAlerta)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @mensajeAlerta
        <button type="button" class="btn-close" @onclick="() => mostrarAlerta = false"></button>
    </div>
}

@if (libros == null)
{
    <div class="text-center">
        <div class="spinner-border text-primary" role="status"></div>
        <p>Cargando libros...</p>
    </div>
}
else if (!LibrosFiltrados.Any())
{
    <div class="alert alert-warning text-center">No se encontraron libros con esa búsqueda.</div>
}
else
{
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Código</th>
                <th>Nombre</th>
                <th>Disponibles</th>
                <th>ID Autor</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            
            @foreach (var libro in LibrosFiltrados)
            {
                <tr>
                    <td>@libro.Codlibro</td>
                    <td>@libro.Nombre</td>
                    <td>
                        <span class="badge bg-info text-dark">@libro.Disponible</span>
                    </td>
                    <td>@libro.Idautor</td>
                    <td>
                        <button class="btn btn-warning btn-sm me-2" @onclick="() => EditarLibro(libro)">Editar</button>
                        <button class="btn btn-danger btn-sm" @onclick="() => EliminarLibro(libro.Codlibro)">Eliminar</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@if (mostrarFormulario)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(isEditing ? "Editar Libro" : "Agregar Libro")</h5>
                    <button type="button" class="btn-close" @onclick="Cancelar"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="libroActual" OnValidSubmit="GuardarLibro">
                        
                        <div class="mb-3">
                            <label class="form-label">Código del Libro:</label>
          
                            <InputNumber class="form-control" @bind-Value="libroActual.Codlibro" disabled="@isEditing" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Nombre del Libro:</label>
                            <InputText class="form-control" @bind-Value="libroActual.Nombre" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Cantidad Disponible:</label>
                            <InputNumber class="form-control" @bind-Value="libroActual.Disponible" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">ID del Autor:</label>
                            <InputNumber class="form-control" @bind-Value="libroActual.Idautor" required />
                        </div>

                        <div class="d-flex justify-content-end mt-3">
                            <button type="submit" class="btn btn-success me-2">Guardar</button>
                            <button type="button" class="btn btn-secondary" @onclick="Cancelar">Cancelar</button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<Libro>? libros;
    private Libro libroActual = new();
    private bool mostrarFormulario = false;
    private bool isEditing = false;
    private string? mensajeAlerta;
    private bool mostrarAlerta = false;

   
    private string filtroBusqueda = "";


    private List<Libro> LibrosFiltrados => 
        string.IsNullOrWhiteSpace(filtroBusqueda) 
        ? libros ?? new List<Libro>()
        : libros!.Where(l => l.Nombre.Contains(filtroBusqueda, StringComparison.OrdinalIgnoreCase) || 
                             l.Codlibro.ToString().Contains(filtroBusqueda)).ToList();

    protected override async Task OnInitializedAsync()
    {
        await CargarLibros();
    }

    private async Task CargarLibros()
    {
        var url = "api/libros";
        libros = await Repositorio.GetAsync<List<Libro>>(url);
    }

    private void MostrarFormulario()
    {
        libroActual = new Libro();
        isEditing = false;
        mostrarFormulario = true;
    }

    private void EditarLibro(Libro libro)
    {
        libroActual = new Libro
        {
            Codlibro = libro.Codlibro,
            Nombre = libro.Nombre,
            Disponible = libro.Disponible,
            Idautor = libro.Idautor
        };
        isEditing = true;
        mostrarFormulario = true;
    }

    private async Task GuardarLibro()
    {
        var url1 = "api/libros";
        var url2 = $"api/libros/{libroActual.Codlibro}";

        if (!isEditing)
            await Repositorio.PostAsync(url1, libroActual);
        else 
            await Repositorio.PutAsync(url2, libroActual);

        await CargarLibros();
        mostrarFormulario = false;
        mensajeAlerta = "Libro guardado exitosamente.";
        mostrarAlerta = true;
        filtroBusqueda = ""; 
    }

    private async Task EliminarLibro(int cod)
    {
        var url2 = $"api/libros/{cod}";
        await Repositorio.DeleteAsync(url2);
        await CargarLibros();
        mensajeAlerta = "Libro eliminado exitosamente.";
        mostrarAlerta = true;
    }

    private void Cancelar()
    {
        mostrarFormulario = false;
    }
}