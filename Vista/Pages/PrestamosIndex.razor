@page "/prestamos"
@inject IRepositorio Repositorio

<h3 class="text-center mt-4">Novedades: Gestión de Préstamos</h3>
<div class="d-flex justify-content-end mb-3">
    <button class="btn btn-primary" @onclick="MostrarFormulario">
        Nuevo Préstamo
    </button>
</div>

@if (mostrarAlerta)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @mensajeAlerta
        <button type="button" class="btn-close" @onclick="() => mostrarAlerta = false"></button>
    </div>
}

@if (prestamos == null)
{
    <div class="text-center">
        <div class="spinner-border text-primary" role="status"></div>
        <p>Cargando novedades...</p>
    </div>
}
else if (!prestamos.Any())
{
    <div class="alert alert-info text-center">No hay préstamos registrados.</div>
}
else
{
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Cód. Libro</th>
                <th>ID Lector</th>
                <th>Fecha Préstamo</th>
                <th>Fecha Esperada</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var prestamo in prestamos)
            {
                <tr>
                    <td>@prestamo.IdPrestamo</td>
                    <td>@prestamo.Codlibro</td>
                    <td>@prestamo.Idlector</td>
                    <td>@prestamo.FechaPrestamo.ToString("dd/MM/yyyy")</td>
                    <td>@prestamo.FechaDevolucionE.ToString("dd/MM/yyyy")</td>
                    <td>
                        @if (prestamo.Estado == "A")
                        {
                            <span class="badge bg-warning text-dark">Activo</span>
                        }
                        else
                        {
                            <span class="badge bg-success">Reintegrado</span>
                        }
                    </td>
                    <td>
                        @if (prestamo.Estado == "A")
                        {
                            <button class="btn btn-success btn-sm" @onclick="() => ReintegrarLibro(prestamo)">
                                Reintegrar
                            </button>
                        }
                        else
                        {
                            <button class="btn btn-secondary btn-sm" disabled>Completado</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@if (mostrarFormulario)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Registrar Nuevo Préstamo</h5>
                    <button type="button" class="btn-close" @onclick="Cancelar"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="prestamoActual" OnValidSubmit="GuardarPrestamo">

                        <div class="mb-3">
                            <label class="form-label">Código del Libro:</label>
                            <InputNumber class="form-control" @bind-Value="prestamoActual.Codlibro" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">ID del Lector:</label>
                            <InputNumber class="form-control" @bind-Value="prestamoActual.Idlector" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">ID del Empleado (Quien presta):</label>
                            <InputNumber class="form-control" @bind-Value="prestamoActual.IdEmpleado" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Fecha de Devolución Esperada:</label>
                            <InputDate class="form-control" @bind-Value="prestamoActual.FechaDevolucionE" required />
                        </div>

                        <div class="d-flex justify-content-end mt-3">
                            <button type="submit" class="btn btn-success me-2">Prestar</button>
                            <button type="button" class="btn btn-secondary" @onclick="Cancelar">Cancelar</button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<Prestamo>? prestamos;
    private Prestamo prestamoActual = new();
    private bool mostrarFormulario = false;
    private string? mensajeAlerta;
    private bool mostrarAlerta = false;

    protected override async Task OnInitializedAsync()
    {
        await CargarPrestamos();
    }

    private async Task CargarPrestamos()
    {
        var url = "api/prestamos";
        prestamos = await Repositorio.GetAsync<List<Prestamo>>(url);
    }

    private void MostrarFormulario()
    {
        prestamoActual = new Prestamo
        {
            FechaPrestamo = DateTime.Now,
            FechaDevolucionE = DateTime.Now.AddDays(7), 
            Estado = "A" 
        };
        mostrarFormulario = true;
    }

    private async Task GuardarPrestamo()
    {
        var url = "api/prestamos";
        await Repositorio.PostAsync(url, prestamoActual);

        await CargarPrestamos();
        mostrarFormulario = false;
        mensajeAlerta = "Préstamo registrado exitosamente.";
        mostrarAlerta = true;
    }

    private async Task ReintegrarLibro(Prestamo prestamo)
    {
        prestamo.Estado = "R";
        prestamo.FechaDevolucionR = DateTime.Now;

        var url = $"api/prestamos/{prestamo.IdPrestamo}";
        await Repositorio.PutAsync(url, prestamo);

        await CargarPrestamos();
        mensajeAlerta = "Libro reintegrado exitosamente.";
        mostrarAlerta = true;
    }

    private void Cancelar()
    {
        mostrarFormulario = false;
    }
}