@page "/reporte-prestamos"
@inject IRepositorio Repositorio

<h3 class="text-center mt-4 mb-4">Reporte: Historial General de Préstamos</h3>
<h6 class="text-center text-muted mb-4">(Vista SQL: vw_HistorialPrestamos)</h6>

<div class="card shadow">
    <div class="card-body p-0">
        @if (historial == null)
        {
            <div class="text-center p-4">
                <div class="spinner-border text-primary" role="status"></div>
                <p class="mt-2">Generando reporte...</p>
            </div>
        }
        else if (!historial.Any())
        {
            <div class="alert alert-info text-center m-3">
                No hay información en el historial de préstamos.
            </div>
        }
        else
        {
            <table class="table table-striped table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Doc. Lector</th>
                        <th>Nombre Lector</th>
                        <th>Tipo</th>
                        <th>Cód. Libro</th>
                        <th>Nombre Libro</th>
                        <th>Fecha Préstamo</th>
                        <th>Devolución Esperada</th>
                        <th>Estado</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var fila in historial)
                    {
                        <tr>
                            <td>@fila.DocumentoLector</td>
                            <td>@fila.NombreLector</td>
                            <td><span class="badge bg-secondary">@fila.TipoLector</span></td>
                            <td>@fila.CodigoLibro</td>
                            <td>@fila.NombreLibro</td>
                            <td>@fila.FechaPrestamo.ToString("dd/MM/yyyy")</td>
                            <td>@fila.FechaEsperada.ToString("dd/MM/yyyy")</td>
                            <td>
                                @if (fila.EstadoPrestamo == "A")
                                {
                                    <span class="badge bg-warning text-dark">Activo</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">Reintegrado</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

@code {
    private List<VwHistorialPrestamo>? historial;

    protected override async Task OnInitializedAsync()
    {
        var url = "api/reportes/historial";
        historial = await Repositorio.GetAsync<List<VwHistorialPrestamo>>(url);
    }
}
